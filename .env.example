# ── Anthropic ────────────────────────────────────────────────────────────────
# Without this the deterministic stub planner is used instead of claude-sonnet-5.
ANTHROPIC_API_KEY=sk-ant-...

# ── GitHub ───────────────────────────────────────────────────────────────────
# Needs org write. A read-only token cannot seed the fixture or remediate:
#   gh auth refresh -h github.com -s admin:org,repo
#   gh auth token
GITHUB_TOKEN=gho_...
GITHUB_ORG=your-demo-org

# The departing employee. Must be an ACTIVE org member — a pending invitation
# holds no team-derived grant, so the seeded failure cannot exist until accepted.
DEPARTING_GITHUB_LOGIN=second-account
DEPARTING_EMAIL=departing@example.com
DEPARTING_NAME=Dana Departing

# Who inherits transferred resources. Must not be the departing employee.
SUCCESSOR_GITHUB_LOGIN=your-main-account
SUCCESSOR_EMAIL=successor@example.com

# Fixture names (optional)
DEMO_REPO=payments-core
DEMO_TEAM=payments

# ── Google Drive ─────────────────────────────────────────────────────────────
# Either the JSON itself or a path to a file, shaped:
#   {"client_id":"...","client_secret":"...","refresh_token":"..."}
# A refresh token is required: the agent runs unattended, so there is no consent
# round-trip at run time.
GOOGLE_OAUTH_CREDENTIALS=./google-oauth.json

# ── Linear ───────────────────────────────────────────────────────────────────
LINEAR_API_KEY=lin_api_...

# ── Slack ────────────────────────────────────────────────────────────────────
# Bot token needs chat:write, and chat:write is also used to undo a post on rollback.
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL=#offboarding

# Optional. Where the offboarding audit issue is filed.
# Unset resolves to the first team in the workspace; npm run preflight prints which.
LINEAR_TEAM_ID=
